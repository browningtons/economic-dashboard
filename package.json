{
  "homepage": "https://browningtons.github.io/economic-dashboard/",
  "name": "economic-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-clip-pages.mjs",
    "predeploy": "npm run build",
    "update:data": "node scripts/update-economic-data.mjs",
    "validate:data": "node scripts/validate-economic-data.mjs",
    "alert:data": "node scripts/send-validation-alert.mjs",
    "check:freshness": "node scripts/check-data-freshness.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@emnapi/wasi-threads": "1.2.2"
  }
}
